# Node modules (platform-specific native bindings)
**/node_modules
**/.next

# Python
**/__pycache__
**/*.pyc
**/.venv
**/dist
**/*.egg-info

# Git
.git
.gitignore

# Local credentials and runtime state must never enter the Docker build context.
**/.env
**/.env.*
!**/.env.example
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.sqlite3-*

# IDE
.idea
.vscode
*.swp

# OS
.DS_Store
Thumbs.db

# Build artifacts
**/target
**/*.log

# Test/Dev
**/coverage
**/.pytest_cache
**/.mypy_cache
hindsight-dev/benchmarks
